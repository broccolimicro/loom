import "test/serial"

func source(chan L) {
	while {
		L.send(rand())
	}
}

func sink(chan R) {
	while {
		R.recv()
	}
}

func buffer(chan L, R) {
	while {
		R.send(L.recv())
	}
}

func copy(chan L, R0, R1) {
	while {
		var fixed l
		l = L.recv()
		R0.send(l) and R1.send(l)
	}
}

func split(chan L, Cc, R0, R1) {
	while {
		if Cc.probe() == 0  {
			R0.send(L.recv()) and Cc.recv()
		} or if Cc.probe() == 1 {
			R1.send(L.recv()) and Cc.recv()
		}
	}
}

func merge(chan L0, L1, Cc, R) {
	while {
		if Cc.probe() == 0 {
			R.send(L0.recv()) and Cc.recv()
		} or if Cc.probe() == 1 {
			R.send(L1.recv()) and Cc.recv()
		}
	}
}

func add(chan A, B, S) {
	while {
		S.send(A.recv() + B.recv())
	}
}
