func decomp_Q1(chan A, B, C, D, X, Y) {
	var fixed a,b,c,d,y

	while {
		a = A.recv() and
			b = B.recv() and
			c = C.recv();
		X.send(a + b)

		if c {
			d = D.recv();
			//b = d + a;  //TODO(steven.kneiser): DSA bug? why no b_2?
			//d = b + d;
			y = b + c + d;
			//y = y + b;
			Y.send(y)

		} or if !c {
			skip
		}
	}
}

