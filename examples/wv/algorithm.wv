func squared_distance(chan X0, X1, Y0, Y1, OUT) {
	var fixed dx, dy
	while {
		dx = X1.recv() - X0.recv() and
			dy = Y1.recv() - Y0.recv();
		OUT.send((dx * dx) + (dy * dy))
	}
}

